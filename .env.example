# SpotLink backend - primeri konfiguracionih varijabli okruzenja
# Kopiraj u .env i popuni vrednosti za lokalni razvoj.
# NIKAD ne commit-uj stvarni .env fajl.

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── Baza podataka ─────────────────────────────────────────────────────────────
# Lokalno: H2 (in-memory, automatski)
DATABASE_URL=jdbc:h2:mem:spotlink;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
DATABASE_DRIVER=org.h2.Driver

# Produkcija: PostgreSQL
# DATABASE_URL=jdbc:postgresql://localhost:5432/spotlink
# DATABASE_USERNAME=spotlink
# DATABASE_PASSWORD=change-me
# DATABASE_DRIVER=org.postgresql.Driver

# Velicina connection pool-a
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# ── JWT (mobilni bearer auth) ─────────────────────────────────────────────────
# OBAVEZNO promeniti na produkciji – najmanje 32 bajta entropije
# Aplikacija koristi vrednost direktno kao secret string.
JWT_SECRET=change-me-to-a-secure-random-32-byte-secret-string
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_EXPIRY_DAYS=7
JWT_ISSUER=spotlink
JWT_AUDIENCE=spotlink-mobile

# ── Cookie / sesija (web) ─────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=Lax
SESSION_TTL_HOURS=12

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://127.0.0.1:4200

# ── Domen ─────────────────────────────────────────────────────────────────────
SPOTLINK_DEFAULT_CURRENCY=RSD
QUOTE_TTL_MINUTES=15

# ── Mock provajderi (koristiti na dev/staging, iskljuciti na produkciji) ───────
MOCK_PAYMENT_ENABLED=true
