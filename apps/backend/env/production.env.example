# SpotLink backend production runtime example.
# Placeholder-only file. Store real values in the deployment secret store.

SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080

DATABASE_URL=jdbc:postgresql://<prod-db-host>:5432/<prod-db-name>
DATABASE_USERNAME=<prod-db-user>
DATABASE_PASSWORD=<prod-db-password-from-secret-store>
DATABASE_DRIVER=org.postgresql.Driver
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=4

JWT_SECRET=<production-32-byte-or-longer-random-secret>
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_EXPIRY_DAYS=7
JWT_ISSUER=spotlink
JWT_AUDIENCE=spotlink-mobile

CORS_ORIGINS=https://spotlink.app
COOKIE_SECURE=true
COOKIE_DOMAIN=.spotlink.app
COOKIE_SAME_SITE=Lax
SESSION_TTL_HOURS=12

PAYMENT_PROVIDER=none
ONLINE_PAYMENTS_ENABLED=false
MOCK_PAYMENT_ENABLED=false
PASSWORD_RESET_DELIVERY_ENABLED=false
PASSWORD_RESET_URL=https://spotlink.app/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
MAIL_PROVIDER=none
# To enable real production reset email after sender-domain/DNS and secrets exist:
# PASSWORD_RESET_DELIVERY_ENABLED=true
# MAIL_PROVIDER=smtp
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username-from-secret-store>
SMTP_PASSWORD=<smtp-password-from-secret-store>
SMTP_FROM=no-reply@spotlink.app
SMTP_STARTTLS_ENABLED=true
SMTP_AUTH_ENABLED=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
PUSH_DELIVERY_ENABLED=false
PUSH_PROVIDER=none
APNS_ENVIRONMENT=production
APNS_BUNDLE_ID=com.spotlink.app
APNS_TEAM_ID=<apple-team-id-from-secret-store>
APNS_KEY_ID=<apns-key-id-from-secret-store>
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=<secret-mounted-apns-auth-key-path>
APNS_REQUEST_TIMEOUT_SECONDS=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PERMITS=10
RATE_LIMIT_MOBILE_TOKEN_PERMITS=10
RATE_LIMIT_REGISTRATION_PERMITS=5
RATE_LIMIT_PASSWORD_RESET_REQUEST_PERMITS=5
RATE_LIMIT_PASSWORD_RESET_COMPLETE_PERMITS=10
RATE_LIMIT_ANALYTICS_PERMITS=60
AUTH_LOCKOUT_ENABLED=true
AUTH_LOCKOUT_FAILED_ATTEMPT_THRESHOLD=5
AUTH_LOCKOUT_ROLLING_WINDOW=15m
AUTH_LOCKOUT_DURATION=15m
SPOTLINK_DEFAULT_CURRENCY=RSD
QUOTE_TTL_MINUTES=15
SPOTLINK_LOG_LEVEL=INFO
